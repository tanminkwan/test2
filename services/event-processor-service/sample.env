# =====================
# Event Processor Service 환경 변수 샘플
# =====================

# [공통]
NODE_ENV=development
PORT=3003
SERVICE_NAME=event-processor-service

# [PostgreSQL/TimescaleDB]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD="app123!@#"
POSTGRES_DB=game_statistics
POSTGRES_SSL=false

# [Redis]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CHANNEL=game-events

# [로깅]
LOG_LEVEL=info
LOG_FILE_DIR=./logs
LOG_PRETTY_PRINT=true

# [이벤트 처리]
BATCH_SIZE=1           # 이벤트 버퍼 크기(즉시 flush 테스트 시 1로 설정)
BATCH_INTERVAL_MS=1000 # 버퍼 flush 주기(ms)
MAX_RETRY_COUNT=3

# [배치 처리]
FLUSH_INTERVAL_MS=1000 # 모든 버퍼 flush 주기(ms)

# [디버깅]
DEBUG_MODE=true        # 모든 단계별 상세 로그 활성화

# [파일 로그 복구]
LOG_RECOVERY_ENABLED=false
LOG_RECOVERY_DIR=../game-service/logs/events

# 로깅 설정
LOG_PRETTY=true

# 로그 복구 설정 (선택 사항)
LOG_RECOVERY_INTERVAL_MS=60000 